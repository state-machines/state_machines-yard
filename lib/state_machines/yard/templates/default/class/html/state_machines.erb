<h2>State Machines</h2>

This class contains <%= state_machines.count %> state machine(s).

<% if mermaid? %>
    <script src="https://cdn.jsdelivr.net/npm/mermaid@10.9.1/dist/mermaid.min.js"></script>
    <script>mermaid.initialize({ startOnLoad: true });</script>
<% end %>

<% state_machines.each do |name, machine| %>
    <h3><%= h(machine[:name]) %></h3>
    <p><%= h(machine[:description]) %></p>

    <% if machine[:events]&.any? %>
        <h4>Events</h4>
        <dl class="state_machine_events">
        <% machine[:events].each do |event| %>
            <dt><tt><%= h(event[:name]) %></tt></dt>
            <dd>
            <% if event[:error] %>
                <p>Its transitions cannot be described: <%= h(event[:error]) %></p>
            <% elsif event[:transitions].empty? %>
                <p>No transitions: it never fires.</p>
            <% else %>
                <p>Transitions (from each state the first that matches is taken):</p>
                <ul>
                <% event[:transitions].each do |transition| %>
                    <li><tt><%= h(transition) %></tt></li>
                <% end %>
                </ul>
            <% end %>
            <% if event[:failure].any? %>
                <p>On failure: <tt><%= h(event[:failure].join(', ')) %></tt></p>
            <% end %>
            </dd>
        <% end %>
        </dl>
    <% end %>

    <% if machine[:image] %>
        <img alt="State machine diagram for <%= h(machine[:name]) %>" src="<%= url_for(state_machine_image_path(machine)) %>"/>
    <% elsif machine[:mermaid] %>
        <pre class="mermaid"><%= h(machine[:mermaid]) %></pre>
    <% end %>
<% end %>
